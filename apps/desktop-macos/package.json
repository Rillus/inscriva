{
  "name": "@inscriva/desktop-macos",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "tauri dev",
    "dev:electron": "ELECTRON_DEV=1 electron .",
    "build": "pnpm --filter @inscriva/web build && tauri build",
    "build:electron": "pnpm --filter @inscriva/web build && ELECTRON_DEV=0 electron .",
    "tauri": "tauri",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "node -e \"process.exit(0)\""
  },
  "dependencies": {
    "@inscriva/bridge": "workspace:*",
    "@tauri-apps/api": "^2.4.0",
    "@tauri-apps/plugin-dialog": "^2.2.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.5.0",
    "electron": "^42.11.16",
    "vitest": "^4.1.12",
    "@vitest/coverage-v8": "^4.1.12"
  },
  "main": "electron/main.mjs"
}
